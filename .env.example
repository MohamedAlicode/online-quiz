# Base de données (docker compose up -d)
DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz?schema=public
# Base utilisée par les tests (réinitialisée à chaque lancement : ne jamais pointer vers de vraies données)
TEST_DATABASE_URL=postgresql://quiz:quiz@localhost:5432/quiz_test?schema=public

# Serveur
PORT=3001
JWT_SECRET=remplace-moi-par-une-chaine-aleatoire-d-au-moins-32-caracteres
# Origines autorisées pour CORS et Socket.IO (séparées par des virgules)
CLIENT_ORIGIN=http://localhost:5173

# Production : dossier du front construit, servi par le même serveur (défini dans le Dockerfile)
# WEB_DIST_PATH=/app/apps/web/dist

# Front (laisser vide en dev : Vite proxifie /api et /socket.io vers le serveur)
VITE_API_URL=
